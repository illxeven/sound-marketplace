# Database connection URL
DB_URL=jdbc:mysql://localhost:3306/sound_marketplace_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# Database user name
DB_USER=sound_app_user
# Database password
DB_PASSWORD=your_db_password_here

# SMTP server hostname
MAIL_HOST=smtp.gmail.com
# SMTP server port
MAIL_PORT=587
# SMTP username / sender account
MAIL_USERNAME=your_email@example.com
# SMTP password / app password
MAIL_PASSWORD=your_mail_password_here
# Email sender address
MAIL_SENDER=noreply@soundmarketplace.com

# Stripe secret key (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Stripe publishable key (pk_test_... or pk_live_...)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Stripe webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Secret key for JWT signing (minimum 256 bits / 32 bytes, base64-encoded)
JWT_SECRET=dGVzdC1qd3Qtc2VjcmV0LWZvci10ZXN0aW5nLXB1cnBvc2VzLW9ubHktMzJieXRlcw==
# Secret key for signing audio/video streaming URLs (minimum 32 bytes)
STREAM_SECRET=stream_secret_key_minimum_32_bytes_long_12345
# Base application URL used for links in email notifications
APP_BASE_URL=http://localhost:8080
# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
