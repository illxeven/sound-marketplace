# ==============================================================================
# Sound Marketplace - Java Spring Boot Backend .gitignore
# ==============================================================================

# --- Operating System & General ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- IDEs & Editors ---
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# --- Secrets, Credentials & Environment Files ---
*.env
*.env.*
*.pem
*.key
*.p12
*.jks
credentials.json
*secret*.json
*secret*.txt

# Ignore active backend properties containing private SMTP & Stripe keys
# (Use application.properties.example as the template)
sound-marketplace/src/main/resources/application.properties

# ==============================================================================
# Java Spring Boot / Maven Build Artifacts
# ==============================================================================
sound-marketplace/target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar

# Maven log files
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties

# Uploaded user media during runtime (audio, images)
sound-marketplace/uploads/artwork/*
sound-marketplace/uploads/tracks/*
!sound-marketplace/uploads/artwork/.gitkeep
!sound-marketplace/uploads/tracks/.gitkeep
